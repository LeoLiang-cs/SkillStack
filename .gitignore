.venv/
__pycache__/
*.py[cod]
.DS_Store

# Raw traces can be large and may include generated model outputs.
runs/*
!runs/.gitkeep

# Downloaded ALFWorld benchmark assets are reproducible external data.
data/alfworld/
!data/.gitkeep

# External research sources and generated idea-run artifacts stay local.
papers/
ideaspark_run/

# Local secrets: API keys must never be committed.
.env
.env.*
!.env.example

# Local Python build outputs.
build/
dist/
*.egg-info/

# Throwaway dev probes and unrelated local files (contract scans, one-off scripts).
tmp/
