{
  "_comment": "LLM backends for executor experiments. Keys come from environment variables (.env, git-ignored), never from this file. Prices are list prices at config time (2026-08-18) and are used only for per-run cost estimation.",
  "backends": {
    "zhipu_glm_flashx": {
      "label": "GLM-4.7-FlashX (primary)",
      "base_url": "https://api.z.ai/api/paas/v4/chat/completions",
      "model": "glm-4.7-flashx",
      "api_key_env": "GLM_API_KEY",
      "thinking_disabled": true,
      "prices_usd_per_1m": {
        "input": 0.07,
        "cached_input": 0.01,
        "output": 0.4
      }
    },
    "deepseek_v4_flash": {
      "label": "DeepSeek V4-Flash (secondary)",
      "base_url": "https://api.deepseek.com/chat/completions",
      "model": "deepseek-v4-flash",
      "api_key_env": "DEEPSEEK_API_KEY",
      "thinking_disabled": true,
      "prices_usd_per_1m": {
        "input": 0.44,
        "cached_input": 0.014,
        "output": 1.32
      }
    }
  },
  "defaults": {
    "temperature": 0,
    "max_tokens_per_step": 512,
    "request_timeout_seconds": 120,
    "max_retries_per_call": 3,
    "retry_backoff_seconds": 2.0
  }
}
